+/* ====================== FORCE LOGOUT (admin sets ForceLogout = Y in Users sheet) ======================
+ * Checked only when the app opens or returns to the foreground — no timer
+ * polling. A failed/offline check NEVER logs the user out. */
+let _forceLogoutBusy = false;
+async function checkForceLogout(){
+  if(!session || _forceLogoutBusy) return;
+  _forceLogoutBusy = true;
+  try{
+    const r = await api('checkSession', {userId: session.userId});
+    if(r && r.ok && r.forceLogout){
+      toast('You were logged out by admin. Please log in again.');
+      finishLogout();
+    }
+  }catch(e){ /* network/backend error: stay logged in */ }
+  finally{ _forceLogoutBusy = false; }
+}
+document.addEventListener('visibilitychange', ()=>{
+  if(document.visibilityState === 'visible') checkForceLogout();
+});
